# =============================================================================
# LAUNDROQR — ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# =============================================================================
# UYARI: Bu dosyaya gerçek API anahtarları veya gizli bilgiler YAZMAYIN.
# Geliştirme için bu dosyayı `apps/admin/.env.local` olarak kopyalayın.

# --- Supabase (Web & Mobil Ortak Genel Bilgiler) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# --- Supabase Yalnızca Sunucu Tarafı (ASLA istemciye veya mobile açmayın!) ---
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY"

# --- Uygulama Yapılandırması ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="tr"

# --- Push Bildirimleri (Faz 8 - Opsiyonel / İleri Faz) ---
FCM_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FCM_CLIENT_EMAIL="YOUR_FIREBASE_CLIENT_EMAIL"
FCM_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY"
